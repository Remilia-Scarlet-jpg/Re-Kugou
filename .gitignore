# ============================================================
# RE:KG 项目 .gitignore
# 仅允许必要文件上传;目标仓库: https://github.com/Remilia-Scarlet-jpg/Re-Kugou
# 注意:gitignore 不支持行内注释(模式行中 # 会被当作模式内容),注释一律独占一行
# ============================================================

# ---------- 依赖(体积大,一律不传;lock 文件保留 -> 可复现安装) ----------
node_modules/

# ---------- 构建产物 / 打包输出 ----------
release/
build/staging/
bin/
dist/

# ---------- 敏感信息:任何 .env(仅保留 .env.example 模板) ----------
.env
.env.*
!.env.example

# ---------- 日志与调试残留 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
.vscode/
.idea/
*.suo
*.user

# ---------- 测试 / 覆盖率缓存 ----------
coverage/
.cache/

# ---------- 嵌套仓库元数据(必读) ----------
# api/ 是上游 KuGouMusicApi 的 clone(内含 .git)。Git 会把含 .git 的目录当作
# "嵌入仓库",只提交 gitlink 指针、不传 api/ 源码内容。
# 上传前请先执行: Remove-Item -Recurse -Force api\.git
# api/.git/ 条目仅为双保险;规范上 .git 目录本身不会被跟踪。
api/.git/

# ---------- 文档与安全报告(公开仓库不需要) ----------
bug.md
api/docs/
api/interface.d.ts
